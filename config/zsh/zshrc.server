
# Minimal zshrc for remote servers (bootstrap.sh --server)

# Many servers default to LANG=C (or get an unknown locale via SSH).
# Without UTF-8 zsh prints icons and powerline symbols as "?".
if [[ "$(locale charmap 2>/dev/null)" != "UTF-8" ]]; then
  export LANG=C.UTF-8
  export LC_CTYPE=C.UTF-8
  unset LC_ALL
fi

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Disable bi-weekly auto-update checks.
DISABLE_AUTO_UPDATE="true"

# Enable command auto-correction.
ENABLE_CORRECTION="true"

# Keep plugins small: no gpg-agent, 1password or pyautoenv on servers
plugins=(git zsh-autosuggestions z sudo)

source $ZSH/oh-my-zsh.sh

# User configuration

# Add my alias file
source $HOME/.alias

# Add my custom env
source $HOME/.custom_env

# Add $HOME/.local/bin to path if it exists
if [ -d "$HOME/.local/bin" ] ; then
  path+=("$HOME/.local/bin")
fi

# export to sub-processes (make it inherited by child processes)
export PATH

# Enable starship
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi
