# replace C-b by C-a instead of using both prefixes
 set -gu prefix2
 unbind C-b
 set -g prefix C-a
 bind C-a send-prefix
 
# index starts with 1
set -g base-index 1
set -g pane-base-index 1

# increase history size
set -g history-limit 10000

# start with mouse mode enabled
set -g mouse on

# move status line to top
set -g status-position top
# toggle synchronize-panes
bind S setw synchronize-panes

# quick config reload
bind-key r source-file ~/.tmux.conf \; display-message "~/.tmux.conf reloaded"

# -- Plugins ------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect' # Save tmux sessions
set -g @plugin 'tmux-plugins/tmux-continuum' # Autosave sessions
set -g @plugin 'dracula/tmux' # Dracula Theme

# ressurect options
set -g @resurrect-capture-pane-contents 'on'

# continuum options
set -g @continuum-restore 'on'

# Dracula theme options
set -g @dracula-show-powerline true
set -g @dracula-show-left-icon session
#set -g @dracula-show-empty-plugins false
set -g @dracula-show-edge-icons false
set -g @dracula-show-left-icon "#h | #S"
set -g @dracula-battery-label false
set -g @dracula-show-battery-status true
set -g @dracula-no-battery-label false
set -g @dracula-git-disable-status true
#set -g @dracula-network-vpn-verbose true
set -g @dracula-show-ssh-only-when-connected true
set -g @dracula-synchronize-panes-label "Sync"
#set -g @dracula-show-time true
#set -g @dracula-time-format "%H %M"
#set -g @dracula-show-weather false
set -g @dracula-show-network false
set -g @dracula-show-fahrenheit false

# split panes using | and -
bind-key | split-window -h
bind-key - split-window -v
unbind-key '"'
unbind-key %

# -- Popups --------------------------------

# Lazygit
bind g display-popup \
  -d "#{pane_current_path}" \
  -w 80% \
  -h 80% \
  -E "lazygit"

# Switch open sessions
bind C-j display-popup \
  -E "tmux list-sessions | \
  sed -E 's/:.*$//' | \
  grep -v \"^$(tmux display-message -p '#S')\$\" | \
  fzf --reverse | \
  xargs tmux switch-client -t"

# Htop
bind C-h display-popup -w 80% -h 80% -E "htop"

bind d display-menu -T "#[align=centre]Dotfiles" -x C -y C \
  "ssh config"        s  'display-popup -w 80% -h 80% -E "vim ~/.ssh/config"' \
  ".zshrc"            z  'display-popup -w 80% -h 80% -E "vim ~/.zshrc"' \
  ".tmux.conf"        t  'display-popup -w 80% -h 80% -E "vim ~/.tmux.conf.local"' \
  ".dotfiles dir"     d  'display-popup -d ~/.dotfiles -E "vim ."' \
  ".gitconfig"        g  'display-popup -w 80% -h 80% -E "vim ~/.gitconfig"' \
  "" \
  "Exit"              q  ""

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'